# ==============================================================================
# AI Resource Library Environment Configuration
# Copy this file to .env and insert your API keys where appropriate.
# ==============================================================================

# LLM Providers (At least one is recommended for Phase 4 summary generation)
# Primary fast provider: Groq (supports llama-3.3-70b-versatile, openai/gpt-oss-120b)
GROQ_API_KEY=your_groq_api_key_here

# Anthropic Claude API Key (Optional fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (Optional fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Local Ollama URL (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Pipeline Runtime Settings
LOG_LEVEL=INFO
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
CRAWL_DELAY_SECONDS=1.0
